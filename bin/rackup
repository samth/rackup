#!/bin/sh
set -eu

# Resolve symlinks so SELF_DIR points at the real bin/ directory
# (the shim in ~/.rackup/shims/ is a symlink to this script).
SELF_SCRIPT="$0"
while [ -L "$SELF_SCRIPT" ]; do
  # POSIX-portable readlink: ls -l and strip prefix
  _rackup_link_target="$(ls -ld "$SELF_SCRIPT" 2>/dev/null)" || break
  _rackup_link_target="${_rackup_link_target#*" $SELF_SCRIPT -> "}"
  case "$_rackup_link_target" in
    /*) SELF_SCRIPT="$_rackup_link_target" ;;
    *) SELF_SCRIPT="$(dirname "$SELF_SCRIPT")/$_rackup_link_target" ;;
  esac
done
# shellcheck disable=SC1007
SELF_DIR=$(CDPATH= cd -- "$(dirname "$SELF_SCRIPT")" && pwd)
LIBEXEC_DIR="$SELF_DIR/../libexec"
CORE="$LIBEXEC_DIR/rackup-core.rkt"
CORE_EXE="$SELF_DIR/rackup-core"
BOOTSTRAP_SH="$LIBEXEC_DIR/rackup-bootstrap.sh"

if [ ! -r "$BOOTSTRAP_SH" ]; then
  echo "rackup: missing bootstrap helper: $BOOTSTRAP_SH" >&2
  exit 1
fi

# shellcheck disable=SC1090
. "$BOOTSTRAP_SH"

if [ "${1:-}" = "prompt" ]; then
  case "$#" in
    1)
      rackup_prompt_shell
      exit 0
      ;;
    2)
      case "${2:-}" in
        -h | --help)
          rackup_prompt_help_shell
          exit 0
          ;;
        --raw | --source | --short | --long)
          rackup_prompt_shell "$2"
          exit 0
          ;;
      esac
      ;;
  esac
fi

if [ "${1:-}" = "help" ] && [ "${2:-}" = "prompt" ] && [ "$#" -eq 2 ]; then
  rackup_prompt_help_shell
  exit 0
fi

# Save user's Racket env vars for pass-through (rackup run), then clear
# so rackup's own runtime (embedded exe or hidden runtime) is not affected.
rackup_save_and_clear_racket_env() {
  for _rackup_v in PLTCOLLECTS PLTADDONDIR PLTCOMPILEDROOTS PLTUSERHOME RACKET_XPATCH PLT_COMPILED_FILE_CHECK; do
    eval "_rackup_val=\${$_rackup_v:-}"
    if [ -n "$_rackup_val" ]; then
      eval "export _RACKUP_ORIG_$_rackup_v=\"\$_rackup_val\""
    fi
  done
  unset PLTCOLLECTS PLTADDONDIR PLTCOMPILEDROOTS PLTUSERHOME RACKET_XPATCH PLT_COMPILED_FILE_CHECK
}

# Uninstall: the Racket side validates the target, asks for confirmation,
# and cleans shell init blocks, but does NOT delete RACKUP_HOME, which holds
# the running code.  It exits with RACKUP_UNINSTALL_CONFIRMED only after the
# user confirmed; the wrapper deletes RACKUP_HOME on that status alone.  Any
# other status -- help output (0), a refusal or abort (2), an error --
# deletes nothing and is passed through.
RACKUP_UNINSTALL_CONFIRMED=10
rackup_run_uninstall() {
  _rackup_home="$(rackup_home)"
  _rackup_status=0
  "$@" || _rackup_status=$?
  if [ "$_rackup_status" -ne "$RACKUP_UNINSTALL_CONFIRMED" ]; then
    exit "$_rackup_status"
  fi
  if [ -d "$_rackup_home" ]; then
    rm -rf -- "$_rackup_home"
  fi
  exit 0
}

# --- Prebuilt binary path: if rackup-core binary exists, use it directly ---
if [ -x "$CORE_EXE" ]; then
  rackup_save_and_clear_racket_env
  if [ "${1:-}" = "uninstall" ]; then
    rackup_run_uninstall "$CORE_EXE" "$@"
  fi
  exec "$CORE_EXE" "$@"
fi
# --- End prebuilt binary path ---

USE_Y=0
if rackup_hidden_runtime_present; then
  RACKET_EXE="$(rackup_runtime_current_racket)"
  RUNTIME_ADDON_DIR="$(rackup_runtime_addon_dir)"
else
  RACKET_EXE="$(rackup_select_runtime_racket_or_fail)" || exit 1
  RUNTIME_ADDON_DIR="$(rackup_system_runtime_addon_dir)"
  USE_Y=1
fi
rackup_mkdir_p "$RUNTIME_ADDON_DIR"
rackup_save_and_clear_racket_env

if [ "${1:-}" = "uninstall" ]; then
  # Always use -y for uninstall to handle stale bytecode from runtime upgrades.
  rackup_run_uninstall "$RACKET_EXE" -y -U -A "$RUNTIME_ADDON_DIR" "$CORE" "$@"
fi

if [ "$USE_Y" -eq 1 ]; then
  exec "$RACKET_EXE" -y -U -A "$RUNTIME_ADDON_DIR" "$CORE" "$@"
else
  exec "$RACKET_EXE" -U -A "$RUNTIME_ADDON_DIR" "$CORE" "$@"
fi
